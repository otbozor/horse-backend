generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(uuid())
  telegramUserId       BigInt?           @unique @map("telegram_user_id")
  telegramUsername     String?           @map("telegram_username")
  phone                String?
  username             String?           @unique
  password             String?
  isAdmin              Boolean           @default(false) @map("is_admin")
  displayName          String            @map("display_name")
  avatarUrl            String?           @map("avatar_url")
  isVerified           Boolean           @default(false) @map("is_verified")
  status               UserStatus        @default(ACTIVE)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  lastLoginAt          DateTime?         @map("last_login_at")
  listingCredits       Int               @default(3) @map("listing_credits")
  hasUnlimitedListings Boolean           @default(false) @map("has_unlimited_listings")
  auditLogs            AuditLog[]
  comments             Comment[]
  favorites            Favorite[]
  listings             HorseListing[]
  payments             Payment[]
  productFavorites     ProductFavorite[]
  products             Product[]
  viewLogs             ViewLog[]
  reportsFiled         ListingReport[]
  reviewsGiven         SellerReview[]    @relation("ReviewsGiven")
  reviewsReceived      SellerReview[]    @relation("ReviewsReceived")
  priceOffers          PriceOffer[]
  services             ServiceListing[]
  savedSearches        SavedSearch[]
  horseRequests        HorseRequest[]
  requestResponses     RequestResponse[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model TelegramAuthSession {
  id        String   @id
  type      String
  data      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("telegram_auth_sessions")
}

model Region {
  id        String         @id @default(uuid())
  nameUz    String         @map("name_uz")
  nameRu    String?        @map("name_ru")
  slug      String         @unique
  districts District[]
  events    Event[]
  listings  HorseListing[]
  products  Product[]
  services  ServiceListing[]
  requests  HorseRequest[]

  @@map("regions")
}

model District {
  id       String         @id @default(uuid())
  regionId String         @map("region_id")
  nameUz   String         @map("name_uz")
  nameRu   String?        @map("name_ru")
  slug     String         @unique
  region   Region         @relation(fields: [regionId], references: [id], onDelete: Cascade)
  events   Event[]
  listings HorseListing[]
  products Product[]
  services ServiceListing[]

  @@index([regionId])
  @@map("districts")
}

model Breed {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  description String?
  isActive    Boolean        @default(true) @map("is_active")
  listings    HorseListing[]
  requests    HorseRequest[]

  @@map("breeds")
}

model HorseListing {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  title          String
  slug           String        @unique
  description    String?
  regionId       String?       @map("region_id")
  districtId     String?       @map("district_id")
  purpose        HorsePurpose?
  gender         HorseGender?
  breedId        String?       @map("breed_id")
  ageYears       Int?          @map("age_years")
  color          String?
  priceAmount    Decimal       @map("price_amount") @db.Decimal(15, 2)
  priceCurrency  Currency      @default(UZS) @map("price_currency")
  hasPassport    Boolean       @default(false) @map("has_passport")
  hasVaccine     Boolean?      @map("has_vaccine")
  hasVideo       Boolean       @default(false) @map("has_video")
  status         ListingStatus @default(DRAFT)
  rejectReason   String?       @map("reject_reason")
  viewCount      Int           @default(0) @map("view_count")
  favoriteCount  Int           @default(0) @map("favorite_count")
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  isPaid         Boolean       @default(false) @map("is_paid")
  isTop          Boolean       @default(false) @map("is_top")
  expiresAt      DateTime?     @map("expires_at")
  boostExpiresAt DateTime?     @map("boost_expires_at")
  isPremium      Boolean       @default(false) @map("is_premium")
  saleSource     SaleSource?   @map("sale_source")
  contactName    String?       @map("contact_name")
  contactPhone   String?       @map("contact_phone")
  contactTelegram String?      @map("contact_telegram")
  previousPrice  Decimal?      @map("previous_price") @db.Decimal(15, 2)
  comments       Comment[]
  favorites      Favorite[]
  breed          Breed?        @relation(fields: [breedId], references: [id])
  district       District?     @relation(fields: [districtId], references: [id])
  region         Region?       @relation(fields: [regionId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media          HorseMedia[]
  payments       Payment[]
  viewLogs       ViewLog[]
  reports        ListingReport[]
  reviews        SellerReview[]
  priceOffers    PriceOffer[]
  priceHistory   PriceHistory[]
  requestResponses RequestResponse[]

  @@index([userId])
  @@index([regionId])
  @@index([status])
  @@index([publishedAt])
  @@map("horse_listings")
}

model HorseMedia {
  id        String       @id @default(uuid())
  listingId String       @map("listing_id")
  type      MediaType    @default(IMAGE)
  url       String
  thumbUrl  String?      @map("thumb_url")
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  listing   HorseListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("horse_media")
}

model Favorite {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  listingId String       @map("listing_id")
  createdAt DateTime     @default(now()) @map("created_at")
  listing   HorseListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("favorites")
}

model ViewLog {
  id        String       @id @default(uuid())
  listingId String       @map("listing_id")
  userId    String?      @map("user_id")
  sessionId String?      @map("session_id")
  createdAt DateTime     @default(now()) @map("created_at")
  listing   HorseListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@map("view_logs")
}

model Comment {
  id        String       @id @default(uuid())
  listingId String       @map("listing_id")
  userId    String       @map("user_id")
  content   String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  parentId  String?      @map("parent_id")
  listing   HorseListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  parent    Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]    @relation("CommentReplies")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model Event {
  id              String      @id @default(uuid())
  title           String
  slug            String      @unique
  description     String?
  regionId        String      @map("region_id")
  districtId      String?     @map("district_id")
  addressText     String?     @map("address_text")
  mapUrl          String?     @map("map_url")
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  organizerName   String      @map("organizer_name")
  contactPhone    String?     @map("contact_phone")
  contactTelegram String?     @map("contact_telegram")
  prizePool       String?     @map("prize_pool")
  prizeCurrency   Currency    @default(UZS) @map("prize_currency")
  rules           String?
  status          EventStatus @default(DRAFT)
  viewCount       Int         @default(0) @map("view_count")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  publishedAt     DateTime?   @map("published_at")
  district        District?   @relation(fields: [districtId], references: [id])
  region          Region      @relation(fields: [regionId], references: [id])

  @@index([regionId])
  @@index([status])
  @@index([startsAt])
  @@map("events")
}

model ProductCategory {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  products Product[]

  @@map("product_categories")
}

model Product {
  id               String            @id @default(uuid())
  title            String
  slug             String            @unique
  categoryId       String?           @map("category_id")
  description      String?
  priceAmount      Decimal           @map("price_amount") @db.Decimal(15, 2)
  priceCurrency    Currency          @default(UZS) @map("price_currency")
  hasDelivery      Boolean           @default(false) @map("has_delivery")
  stockStatus      StockStatus       @default(IN_STOCK) @map("stock_status")
  status           ProductStatus     @default(DRAFT)
  viewCount        Int               @default(0) @map("view_count")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  publishedAt      DateTime?         @map("published_at")
  userId           String?           @map("user_id")
  isPaid           Boolean           @default(false) @map("is_paid")
  districtId       String?           @map("district_id")
  favoriteCount    Int               @default(0) @map("favorite_count")
  regionId         String?           @map("region_id")
  payments         Payment[]
  productFavorites ProductFavorite[]
  media            ProductMedia[]
  category         ProductCategory?  @relation(fields: [categoryId], references: [id])
  district         District?         @relation(fields: [districtId], references: [id])
  region           Region?           @relation(fields: [regionId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])

  @@index([categoryId])
  @@index([userId])
  @@index([regionId])
  @@index([status])
  @@index([publishedAt])
  @@map("products")
}

model ProductFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("product_favorites")
}

model ProductMedia {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  thumbUrl  String?  @map("thumb_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model BlogPost {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String
  coverImage  String?        @map("cover_image")
  authorId    String         @map("author_id")
  status      BlogPostStatus @default(DRAFT)
  viewCount   Int            @default(0) @map("view_count")
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  keywords    String?

  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model Payment {
  id                String          @id @default(uuid())
  listingId         String?         @map("listing_id")
  userId            String          @map("user_id")
  packageType       PaymentPackage? @map("package_type")
  amount            Decimal         @map("amount") @db.Decimal(15, 2)
  status            PaymentStatus   @default(PENDING)
  clickTransId      String?         @map("click_trans_id")
  clickPaydocId     String?         @map("click_paydoc_id")
  merchantPrepareId Int             @default(0) @map("merchant_prepare_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  productId         String?         @map("product_id")
  listingBundleSize Int?            @map("listing_bundle_size")
  method            PaymentMethod   @default(CLICK)
  starsAmount       Int?            @map("stars_amount")
  telegramChargeId  String?         @map("telegram_charge_id")
  listing           HorseListing?   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  diffJson    Json?    @map("diff_json")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum HorsePurpose {
  KOPKARI
  SPORT
  SAYR
  ISHCHI
  NASLCHILIK
  GOSHT
}

enum HorseGender {
  AYGIR
  BIYA
  AXTA
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
  EXPIRED
}

enum SaleSource {
  OTBOZOR
  OTHER
}

enum Currency {
  UZS
  USD
}

enum MediaType {
  IMAGE
  VIDEO
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentPackage {
  OSON_START
  TEZKOR_SAVDO
  TURBO_SAVDO
}

model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("cache_entries")
}

// ---------- Ishonch va savdo ----------

model ListingReport {
  id         String       @id @default(uuid())
  listingId  String       @map("listing_id")
  reporterId String       @map("reporter_id")
  reason     ReportReason
  comment    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")
  listing    HorseListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([listingId, reporterId])
  @@index([status])
  @@map("listing_reports")
}

model SellerReview {
  id              String        @id @default(uuid())
  sellerId        String        @map("seller_id")
  reviewerId      String        @map("reviewer_id")
  listingId       String?       @map("listing_id")
  stars           Int
  comment         String?
  sellerReply     String?       @map("seller_reply")
  sellerRepliedAt DateTime?     @map("seller_replied_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  seller          User          @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer        User          @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  listing         HorseListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([sellerId, reviewerId])
  @@index([sellerId])
  @@map("seller_reviews")
}

model PriceOffer {
  id          String           @id @default(uuid())
  listingId   String           @map("listing_id")
  buyerId     String           @map("buyer_id")
  amount      Decimal          @db.Decimal(15, 2)
  currency    Currency         @default(UZS)
  message     String?
  status      PriceOfferStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")
  listing     HorseListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer       User             @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([buyerId])
  @@map("price_offers")
}

model PriceHistory {
  id        String       @id @default(uuid())
  listingId String       @map("listing_id")
  oldPrice  Decimal      @map("old_price") @db.Decimal(15, 2)
  newPrice  Decimal      @map("new_price") @db.Decimal(15, 2)
  currency  Currency     @default(UZS)
  createdAt DateTime     @default(now()) @map("created_at")
  listing   HorseListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("price_history")
}

enum ReportReason {
  FRAUD
  SOLD
  WRONG_INFO
  DUPLICATE
  OFFENSIVE
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum PriceOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// ---------- Xizmatlar katalogi (veterinar, taqachi, ot tashish...) ----------

model ServiceListing {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  category        ServiceCategory
  title           String
  description     String?
  regionId        String?         @map("region_id")
  districtId      String?         @map("district_id")
  priceFrom       Decimal?        @map("price_from") @db.Decimal(15, 2)
  priceNote       String?         @map("price_note")
  contactName     String?         @map("contact_name")
  contactPhone    String?         @map("contact_phone")
  contactTelegram String?         @map("contact_telegram")
  status          ServiceStatus   @default(PENDING)
  rejectReason    String?         @map("reject_reason")
  viewCount       Int             @default(0) @map("view_count")
  publishedAt     DateTime?       @map("published_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  region          Region?         @relation(fields: [regionId], references: [id])
  district        District?       @relation(fields: [districtId], references: [id])
  media           ServiceMedia[]

  @@index([status, category])
  @@index([userId])
  @@index([regionId])
  @@map("service_listings")
}

model ServiceMedia {
  id        String         @id @default(uuid())
  serviceId String         @map("service_id")
  url       String
  sortOrder Int            @default(0) @map("sort_order")
  service   ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_media")
}

enum ServiceCategory {
  VETERINAR
  TAQACHI
  OT_TASHISH
  CHAVANDOZ
  MURABBIY
  OT_BOQISH
  EGAR_USTASI
  YEM_YETKAZISH
  BOSHQA
}

enum ServiceStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

// ---------- Saqlangan qidiruv (bot xabarnomasi) ----------

model SavedSearch {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  label          String
  filters        Json
  isActive       Boolean   @default(true) @map("is_active")
  matchCount     Int       @default(0) @map("match_count")
  lastNotifiedAt DateTime? @map("last_notified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("saved_searches")
}

// ---------- "Ot kerak" so'rovlari ----------

model HorseRequest {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  title           String
  description     String?
  purpose         HorsePurpose?
  gender          HorseGender?
  breedId         String?            @map("breed_id")
  ageMin          Int?               @map("age_min")
  ageMax          Int?               @map("age_max")
  budgetMax       Decimal?           @map("budget_max") @db.Decimal(15, 2)
  regionId        String?            @map("region_id")
  contactPhone    String?            @map("contact_phone")
  contactTelegram String?            @map("contact_telegram")
  status          HorseRequestStatus @default(ACTIVE)
  viewCount       Int                @default(0) @map("view_count")
  expiresAt       DateTime           @map("expires_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  breed           Breed?             @relation(fields: [breedId], references: [id])
  region          Region?            @relation(fields: [regionId], references: [id])
  responses       RequestResponse[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("horse_requests")
}

model RequestResponse {
  id          String        @id @default(uuid())
  requestId   String        @map("request_id")
  responderId String        @map("responder_id")
  listingId   String?       @map("listing_id")
  message     String?
  createdAt   DateTime      @default(now()) @map("created_at")
  request     HorseRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder   User          @relation(fields: [responderId], references: [id], onDelete: Cascade)
  listing     HorseListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([responderId])
  @@map("request_responses")
}

enum HorseRequestStatus {
  ACTIVE
  CLOSED
  REMOVED
}

enum PaymentMethod {
  CLICK
  STARS
}
